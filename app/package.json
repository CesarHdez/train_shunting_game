{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@expo/metro-runtime": "~57.0.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@shopify/react-native-skia": "2.6.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.3",
    "expo-haptics": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "puppeteer": "^25.7.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/src/engine/**/*.test.ts",
      "**/src/controller/**/*.test.ts",
      "**/src/render/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "babel-jest",
        {
          "configFile": false,
          "babelrc": false,
          "presets": [
            "@babel/preset-typescript"
          ],
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    }
  },
  "private": true
}
