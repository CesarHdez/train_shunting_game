# Dependencias
node_modules/

# Salidas de compilación y previsualización (se regeneran con `npx expo export`)
app/.webdist/
app/dist/
app/web-build/
.expo/

# Capturas de verificación generadas por tools/*.mjs — desechables, pesan mucho
app/tools/shots/

# Configuración local de Claude Code (por máquina, no del proyecto)
.claude/settings.local.json

# Logs y basura del sistema
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
Thumbs.db
