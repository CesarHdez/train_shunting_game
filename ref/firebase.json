{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "server.py",
      "compute_min_moves.js",
      "CLAUDE.md",
      "patio-clasificacion_1.jsx",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "skills-lock.json"
    ],
    "headers": [
      {
        "source": "**/*.json",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
